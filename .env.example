# ============================================================
# DataShield LLM Service — environment variables
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.
# ============================================================

# ────────────────────────────────────────────────────────────
# LiteLLM
# ────────────────────────────────────────────────────────────

# Master key for LiteLLM proxy (used internally by APISIX → LiteLLM).
# Generate with: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-litellm-changeme

# ────────────────────────────────────────────────────────────
# LLM Provider API Keys
#
# By default, ALL Cursor-facing models in config/litellm/config.yaml
# are routed through OpenRouter (entries with the `openrouter/...`
# prefix). That means OPENROUTER_API_KEY (defined further below) is
# the only provider credential you need to fill in.
#
# Leave the direct-provider slots below empty unless you switch
# specific models in config/litellm/config.yaml from `openrouter/...`
# back to a native prefix (e.g. `openai/gpt-4o`) for lower latency
# or a direct billing relationship.
# ────────────────────────────────────────────────────────────

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Azure OpenAI (optional)
AZURE_API_KEY=
AZURE_API_BASE=https://<your-resource>.openai.azure.com/
AZURE_API_VERSION=2024-02-01

# ────────────────────────────────────────────────────────────
# PostgreSQL (LiteLLM database)
# ────────────────────────────────────────────────────────────

POSTGRES_PASSWORD=dbpassword9090

# ────────────────────────────────────────────────────────────
# Guardrails AI Hub token (optional)
# Required only if you want to pull additional validators from
# hub.guardrailsai.com. Leave empty to run with built-in guards.
# ────────────────────────────────────────────────────────────

GUARDRAILS_TOKEN=

# ────────────────────────────────────────────────────────────
# Grafana
# ────────────────────────────────────────────────────────────

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ────────────────────────────────────────────────────────────
# APISIX Admin API key
# Used by scripts/init-apisix.sh to configure routes.
# Must match the key set in config/apisix/config.yaml.
# ────────────────────────────────────────────────────────────

APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

# ────────────────────────────────────────────────────────────
# Cursor consumer API key
# This is the Bearer token Cursor users put in their API Key field:
#   Cursor Settings → Models → OpenAI API Key → <value below>
# Add additional keys for each developer/team via init-apisix.sh.
# ────────────────────────────────────────────────────────────

CURSOR_API_KEY=sk-cursor-user1-changeme

# ────────────────────────────────────────────────────────────
# LLaMA Guard backend selection
#
# LLAMA_GUARD_PROVIDER chooses where the safety LLM runs:
#   openrouter — meta-llama/llama-guard-3-8b via OpenRouter API.
#                ~200 ms per check, no GPU required. RECOMMENDED for
#                CPU-only hosts and live demos.
#   ollama     — local llama-guard via Ollama. Fully offline,
#                ~2–5 s on CPU, ~200 ms with NVIDIA GPU.
#
# If LLAMA_GUARD_PROVIDER is empty, the server auto-picks "openrouter"
# when OPENROUTER_API_KEY is set, otherwise "ollama".
# ────────────────────────────────────────────────────────────

LLAMA_GUARD_PROVIDER=openrouter

# ── OpenRouter — primary upstream credential ─────────────────
# Used both as:
#   (a) the LLM provider for ALL Cursor-facing models
#       (see openrouter/* entries in config/litellm/config.yaml), AND
#   (b) the safety model backend for LLaMA Guard (when
#       LLAMA_GUARD_PROVIDER=openrouter above).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLAMA_GUARD_OPENROUTER_MODEL=meta-llama/llama-guard-3-8b

# ────────────────────────────────────────────────────────────
# Ollama — local model runtime (always used for embeddings)
#
# nomic-embed-text is the embedding model used by semantic_guard.
# It's tiny (~274 MB) and fast on CPU, so it stays local even
# when LLaMA Guard runs on OpenRouter.
#
# OLLAMA_VALIDATION_MODEL is used only when LLAMA_GUARD_PROVIDER=ollama:
#   llama-guard3:1b  — fast, ~1GB RAM
#   llama-guard3:8b  — more accurate, ~8GB RAM
#
# Pull models after first start:
#   bash scripts/pull-ollama-models.sh
# ────────────────────────────────────────────────────────────

OLLAMA_VALIDATION_MODEL=llama-guard3:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ────────────────────────────────────────────────────────────
# Optional: log level for guardrails server
# ────────────────────────────────────────────────────────────

GUARDRAILS_LOG_LEVEL=INFO
